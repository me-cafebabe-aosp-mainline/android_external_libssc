#ifndef _PROXY_VERSION_H_
#define _PROXY_VERSION_H_

/**
 * PROXY_MAJOR_VERSION:
 *
 * The major version number of the ssc-sensor-proxy
 * which this source is compiled against.
 *
 * Since: 0.0.1
 */
#define PROXY_MAJOR_VERSION (@PROXY_MAJOR_VERSION@)

/**
 * PROXY_MINOR_VERSION:
 *
 * The minor version number of the ssc-sensor-proxy
 * which this source is compiled against.
 *
 * Since: 0.0.1
 */
#define PROXY_MINOR_VERSION (@PROXY_MINOR_VERSION@)

/**
 * PROXY_PATCH_VERSION:
 *
 * The patch version number of the ssc-sensor-proxy
 * which this source is compiled against.
 *
 * Since: 0.0.1
 */
#define PROXY_PATCH_VERSION (@PROXY_PATCH_VERSION@)

/**
 * PROXY_CHECK_VERSION:
 * @major: major version (e.g. 1 for version 1.2.3)
 * @minor: minor version (e.g. 2 for version 1.2.3)
 * @patch: patch version (e.g. 3 for version 1.2.3)
 *
 * Checks the version of the ssc-sensor-proxy that is being compilex against.
 *
 * Returns: %TRUE if the version of header files is equal or newer than the passed-in values.
 *
 * Since: 0.0.1
 */
#define PROXY_CHECK_VERSION(major,minor,patch) \
	(PROXY_MAJOR_VERSION > (major) || \
	(PROXY_MAJOR_VERSION == (major) && PROXY_MINOR_VERSION > (minor)) || \
	(PROXY_MAJOR_VERSION == (major) && PROXY_MINOR_VERSION == (minor) && PROXY_PATCH_VERSION >= (patch)))

#endif /* _PROXY_VERSION_H_ */
